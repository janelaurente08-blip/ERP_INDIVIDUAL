{{> head }}

<body class="min-h-screen bg-[#e9e7e1]">
  <div class="flex min-h-screen flex-col md:flex-row">
    {{> sidebar }}

    <div class="flex min-w-0 flex-1 flex-col">
      <header class="border-b border-gray-300 bg-white px-6 py-5 md:px-8">
        <h1 class="text-2xl font-bold text-slate-800">Manage Tasks</h1>
        <p class="mt-1 text-sm text-slate-500">Create and monitor worker tasks.</p>
      </header>

      <main class="flex-1 space-y-6 p-6 md:p-8">

        <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-800">Add Task</h2>

          <form action="/tasks" method="POST" class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
            <input name="title" required placeholder="Task title"
              class="rounded-md border border-gray-300 px-4 py-3">

            <select name="assignedWorkerId" class="rounded-md border border-gray-300 px-4 py-3">
              <option value="">Unassigned</option>
              {{#each workers}}
              <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>

            <input name="dueDate" type="date"
              class="rounded-md border border-gray-300 px-4 py-3">

            <select name="status" class="rounded-md border border-gray-300 px-4 py-3">
              <option value="Pending">Pending</option>
              <option value="In Progress">In Progress</option>
              <option value="Completed">Completed</option>
            </select>

            <textarea name="description" placeholder="Task description"
              class="rounded-md border border-gray-300 px-4 py-3 md:col-span-2"></textarea>

            <button type="submit"
              class="rounded-md bg-slate-800 px-5 py-3 font-semibold text-white hover:bg-slate-700 md:col-span-2">
              Save Task
            </button>
          </form>
        </section>

        <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-800">Task Records</h2>

          <div class="mt-5 overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="border-b bg-gray-50 text-slate-500">
                <tr>
                  <th class="px-4 py-3">Task</th>
                  <th class="px-4 py-3">Assigned Worker ID</th>
                  <th class="px-4 py-3">Due Date</th>
                  <th class="px-4 py-3">Status</th>
                </tr>
              </thead>
              <tbody>
                {{#each tasks}}
                <tr class="border-b last:border-0">
                  <td class="px-4 py-3">{{this.title}}</td>
                  <td class="px-4 py-3">{{this.assignedWorkerId}}</td>
                  <td class="px-4 py-3">{{this.dueDate}}</td>
                  <td class="px-4 py-3">{{this.status}}</td>
                </tr>
                {{else}}
                <tr>
                  <td colspan="4" class="px-4 py-8 text-center text-slate-400">
                    No tasks added yet.
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </section>

      </main>

      {{> footer }}
    </div>
  </div>
