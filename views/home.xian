{{> head }}

<body class="min-h-screen bg-[#e9e7e1]">
  <div class="flex min-h-screen flex-col md:flex-row">
    {{> sidebar }}

    <div class="flex min-w-0 flex-1 flex-col">
      <header class="border-b border-gray-300 bg-white px-6 py-5 md:px-8">
        <h1 class="text-2xl font-bold text-slate-800">Dashboard Overview</h1>
        <p class="mt-1 text-sm text-slate-500">Monitor workforce performance and daily activities.</p>
      </header>

      <main class="flex-1 p-6 md:p-8">
        <section class="mb-8 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
          <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Total Workers</p>
            <p class="mt-3 text-3xl font-bold text-slate-800">{{totalWorkers}}</p>
            <p class="mt-2 text-xs text-slate-400">Registered workers</p>
          </div>

          <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Working Hours</p>
            <p class="mt-3 text-3xl font-bold text-slate-800">0</p>
            <p class="mt-2 text-xs text-slate-400">Total hours recorded</p>
          </div>

          <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Assigned Tasks</p>
            <p class="mt-3 text-3xl font-bold text-slate-800">0</p>
            <p class="mt-2 text-xs text-slate-400">Tasks assigned to workers</p>
          </div>

          <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
            <p class="text-sm text-slate-500">Completed Tasks</p>
            <p class="mt-3 text-3xl font-bold text-slate-800">0</p>
            <p class="mt-2 text-xs text-slate-400">Successfully completed</p>
          </div>
        </section>

        <section class="mb-8 grid grid-cols-1 gap-5 lg:grid-cols-2">
          <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-slate-800">Worker Management</h2>
            <p class="mt-2 text-sm text-slate-500">Register workers and monitor their working hours.</p>
            <a href="/workers" class="mt-5 inline-block rounded-md bg-slate-800 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-700">
              Manage Workers
            </a>
          </div>

          <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-slate-800">Task Management</h2>
            <p class="mt-2 text-sm text-slate-500">Assign tasks and monitor their completion status.</p>
            <a href="/tasks" class="mt-5 inline-block rounded-md bg-slate-800 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-700">
              Manage Tasks
            </a>
          </div>
        </section>

        <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-800">Recent Activities</h2>
          <div class="mt-5 overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="border-b bg-gray-50 text-slate-500">
                <tr>
                  <th class="px-4 py-3">Worker</th>
                  <th class="px-4 py-3">Task</th>
                  <th class="px-4 py-3">Working Hours</th>
                  <th class="px-4 py-3">Status</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td colspan="4" class="px-4 py-8 text-center text-slate-400">No activities recorded yet.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </main>

      {{> footer }}
    </div>
  </div>
