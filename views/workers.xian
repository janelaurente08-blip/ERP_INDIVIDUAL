{{> head }}

<body class="min-h-screen bg-[#e9e7e1]">
  <div class="flex min-h-screen flex-col md:flex-row">
    {{> sidebar }}

    <div class="flex min-w-0 flex-1 flex-col">
      <header class="border-b border-gray-300 bg-white px-6 py-5 md:px-8">
        <h1 class="text-2xl font-bold text-slate-800">Manage Workers</h1>
        <p class="mt-1 text-sm text-slate-500">View and manage registered workers.</p>
      </header>

      <main class="flex-1 space-y-6 p-6 md:p-8">

        <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-800">Add Worker</h2>

          <form action="/workers" method="POST" class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2">
            <input name="name" required placeholder="Full name"
              class="rounded-md border border-gray-300 px-4 py-3">

            <input name="position" required placeholder="Position"
              class="rounded-md border border-gray-300 px-4 py-3">

            <input name="department" required placeholder="Department"
              class="rounded-md border border-gray-300 px-4 py-3">

            <input name="contact" placeholder="Contact number"
              class="rounded-md border border-gray-300 px-4 py-3">

            <select name="status" class="rounded-md border border-gray-300 px-4 py-3">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive</option>
            </select>

            <button type="submit"
              class="rounded-md bg-slate-800 px-5 py-3 font-semibold text-white hover:bg-slate-700">
              Save Worker
            </button>
          </form>
        </section>

        <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
          <h2 class="text-lg font-bold text-slate-800">Worker Records</h2>

          <div class="mt-5 overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="border-b bg-gray-50 text-slate-500">
                <tr>
                  <th class="px-4 py-3">Name</th>
                  <th class="px-4 py-3">Position</th>
                  <th class="px-4 py-3">Department</th>
                  <th class="px-4 py-3">Contact</th>
                  <th class="px-4 py-3">Status</th>
                </tr>
              </thead>
              <tbody>
                {{#each workers}}
                <tr class="border-b last:border-0">
                  <td class="px-4 py-3">{{this.name}}</td>
                  <td class="px-4 py-3">{{this.position}}</td>
                  <td class="px-4 py-3">{{this.department}}</td>
                  <td class="px-4 py-3">{{this.contact}}</td>
                  <td class="px-4 py-3">{{this.status}}</td>
                </tr>
                {{else}}
                <tr>
                  <td colspan="5" class="px-4 py-8 text-center text-slate-400">
                    No workers added yet.
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </section>

      </main>

      {{> footer }}
    </div>
  </div>
