
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Productivity Manager | BUILDORA</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/productivity/dashboard.css">
</head>

<body data-role="manager">

<div class="layout">

  <aside class="sidebar">
    <div class="brand">
      <i class="brand-mark"></i>
      BUILDORA
    </div>

    <div class="brand-sub">
      Labor Productivity Management
    </div>

    <div class="role-name">
      Productivity Manager
    </div>

    <nav aria-label="Dashboard navigation">
      <a href="#overview" class="nav-link active">Overview</a>
      <a href="#targets" class="nav-link">Create Target</a>
      <a href="#target-list" class="nav-link">Manage Targets</a>
      <a href="#accomplishments" class="nav-link">Work Accomplishments</a>
      <a href="#reviews" class="nav-link">Performance Reviews</a>
      <a href="#reports" class="nav-link">Productivity Reports</a>
    </nav>
  </aside>

  <div class="main-area">

    <header class="topbar">
      <div>
        <div class="top-title">Productivity Manager</div>
        <div class="top-sub">Targets, performance and reports</div>
      </div>

      <button id="logout" type="button" class="logout">
        Logout
      </button>
    </header>

    <main id="app" class="content" aria-live="polite"></main>

  </div>
</div>

<script src="/productivity/ui.js" defer></script>

</body>
</html>
